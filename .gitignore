deployed-contracts.env

# docs/deployment.md tells the reader to keep their Portainer variables here.
# It holds the service-role key, the Pinata JWT and the indexer secret, so it
# must never be committed.
portainer-env.txt

src/packages/*/node_modules
src/packages/*/dist

# Scratch files that audit subagents write into the repo root. Anchored to the
# root so a legitimately named file deeper in the tree is unaffected.
/probe*.*
/chk-*.*
/t_verify.*
/verify-*-tmp*.*
/*-tmp.*
/*_tmp.*
