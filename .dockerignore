# Rust build artifacts. `cargo build` puts these at the repository root, not
# under contracts/, and on a working checkout it reaches several gigabytes —
# larger than everything else combined. The Node build has no use for Rust
# output, and Docker has to transfer the whole context before it can start.
target/
**/target/
.cargo/

# Claude Code session data and worktrees. Comparable in size to the Rust output
# and equally irrelevant to the image.
.claude/

# Contract sources. The image runs the Next.js app; the generated TypeScript
# bindings it actually imports live under src/packages/.
contracts/

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/
build
dist

# Production
/.pnp
.pnp.js

# Testing
coverage
.nyc_output

# Environment files
# Bare `.env` matters most: it holds real secrets and `COPY . .` would otherwise
# bake it into the builder layer. All config reaches the build via build args
# (see docker-compose.yml) and the runtime via the container environment.
.env
.env*.local
.env.development
.env.test
.env.production

# Debugging
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
README.md
docs/
*.md

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Logs
logs
*.log

# Misc
.husky
.editorconfig
.eslintcache
