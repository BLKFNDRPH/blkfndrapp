# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Two kinds of variable live here, and they reach the container differently:
#
#   NEXT_PUBLIC_*  → build time. Inlined into the client JS bundle by `next build`
#                    and visible to every visitor in DevTools. Public by design.
#                    Reaches Docker via build args (docker-compose.yml `build.args`).
#                    Changing one requires a REBUILD.
#                    Never put a secret behind this prefix.
#
#   everything else → runtime. Read by server code per request, never enters the
#                    image. Reaches Docker via the `environment:` block.
#                    Changing one only needs a RESTART.
#
# In Portainer, set both kinds in Stack → Environment variables. Portainer
# substitutes them into the ${...} placeholders in docker-compose.yml.


# ─── Build time: public Stellar/Soroban config ──────────────────────────────
# Public ledger data. Every var below must also have a matching ARG in the
# Dockerfile, or it silently inlines as "" and fails at runtime.

NEXT_PUBLIC_BLKFNDR_CONTRACT_ID=
NEXT_PUBLIC_BLKFNDR_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_BLKFNDR_IDENTITY_CONTRACT_ID=
NEXT_PUBLIC_BLKFNDR_APPROVAL_CONTRACT_ID=

# Stellar token contract presets
NEXT_PUBLIC_STELLAR_XLM_TOKEN_ID=
NEXT_PUBLIC_STELLAR_USDC_TOKEN_ID=
NEXT_PUBLIC_STELLAR_USDT_TOKEN_ID=
NEXT_PUBLIC_STELLAR_WBTC_TOKEN_ID=
NEXT_PUBLIC_STELLAR_WETH_TOKEN_ID=

# Stellar admin and fallback addresses
NEXT_PUBLIC_STELLAR_ADMIN_ADDRESS=
NEXT_PUBLIC_STELLAR_FALLBACK_ADDRESS=

# ─── Build time: public app config ──────────────────────────────────────────
# Client ID is public; the matching GOOGLE_CLIENT_SECRET below is not.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Origin used to build the OAuth redirect URI. e.g. https://testnetv2.blkfndr.com
NEXT_PUBLIC_APP_URL=


# ─── Runtime: secrets ───────────────────────────────────────────────────────
# Server-only. These never reach the browser.

# src/lib/mongodb.ts
MONGODB_URI=

# Session JWT signing — src/lib/auth/session.ts
# Generate with: openssl rand -base64 32
# Required. The app refuses to start without it rather than sign with a default.
# NEXTAUTH_SECRET is still read as a fallback so existing deployments keep
# working, but NextAuth has been removed — migrate to SESSION_SECRET.
SESSION_SECRET=

# Google sign-in uses the OIDC implicit flow with a server-minted nonce and
# state (src/app/api/auth/google/start). Only the public client ID is needed —
# there is no server-side token exchange, so no client secret is involved.

# Pinata / IPFS uploads — src/app/api/upload-image/route.ts
PINATA_JWT=
PINATA_GATEWAY_URL=
PINATA_GROUP_BLKDFNDR=

# Bearer token for POST /api/indexer — src/app/api/indexer/route.ts
# Required. Without it the endpoint would be publicly callable.
INDEXER_SECRET=

# Genkit — src/ai
GOOGLE_GENERATIVEAI_API_KEY=
