# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Two kinds of variable live here, and they reach the container differently:
#
#   NEXT_PUBLIC_*  → build time. Inlined into the client JS bundle by `next build`
#                    and visible to every visitor in DevTools. Public by design.
#                    Reaches Docker via build args (docker-compose.yml `build.args`).
#                    Changing one requires a REBUILD.
#                    Never put a secret behind this prefix.
#
#   everything else → runtime. Read by server code per request, never enters the
#                    image. Reaches Docker via the `environment:` block.
#                    Changing one only needs a RESTART.
#
# In Portainer, set both kinds in Stack → Environment variables. Portainer
# substitutes them into the ${...} placeholders in docker-compose.yml.


# ─── Build time: public Stellar/Soroban config ──────────────────────────────
# Public ledger data. Every var below must also have a matching ARG in the
# Dockerfile, or it silently inlines as "" and fails at runtime.

NEXT_PUBLIC_BLKFNDR_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_BLKFNDR_IDENTITY_CONTRACT_ID=
NEXT_PUBLIC_BLKFNDR_ADMIN_CONTRACT_ID=

# Append-only builder completion record.
NEXT_PUBLIC_BLKFNDR_ATTESTATION_CONTRACT_ID=

# Stellar Asset Contract address per currency. A project is created against
# whichever address is set here, and the vault then uses that one token for its
# whole life, so a wrong value here escrows the wrong asset.
#
# These are derived, not looked up — the SAC address is a deterministic function
# of the asset and the network passphrase:
#
#   stellar contract id asset --asset native --network testnet
#   stellar contract id asset --asset USDC:<ISSUER_G_ADDRESS> --network testnet
#
# They differ between testnet and mainnet. Deriving them again after a network
# change is not optional.
#
# A currency left blank is simply not offered when creating a project. The UI
# also names the vault's token from these when displaying a milestone release,
# and falls back to the raw address for one it has no name for.
NEXT_PUBLIC_STELLAR_XLM_TOKEN_ID=
NEXT_PUBLIC_STELLAR_USDC_TOKEN_ID=

# Stellar network endpoints.
# BOTH DEFAULT TO TESTNET when empty (src/lib/stellar-clients.ts). A mainnet
# deployment that leaves these blank builds cleanly and then talks to testnet,
# which presents as "no projects appear" rather than as a misconfiguration.
#   testnet: https://soroban-testnet.stellar.org / https://horizon-testnet.stellar.org
#   mainnet: https://mainnet.sorobanrpc.com     / https://horizon.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_HORIZON_URL=

# Stellar admin and fallback addresses
NEXT_PUBLIC_STELLAR_ADMIN_ADDRESS=
NEXT_PUBLIC_STELLAR_FALLBACK_ADDRESS=

# ─── Build time: public app config ──────────────────────────────────────────

# Origin the app is served from, e.g. https://testnetv2.blkfndr.com.
#
# Must match the Supabase Site URL, and the Supabase redirect allow-list needs
# a WILDCARD entry such as https://testnetv2.blkfndr.com/** — this app appends
# a ?next= query to its callbacks, and a literal entry matches none of them.
# An unmatched redirect is not rejected: Supabase silently sends the user to
# the Site URL, which defaults to http://localhost:3000.
#
NEXT_PUBLIC_APP_URL=

# Additional origins this deployment answers on, comma separated. Optional.
# A visitor arriving on one of these is sent back to the same domain after
# signing in, rather than bounced to NEXT_PUBLIC_APP_URL and losing the session
# cookie that was just set for the host they were sent to.
#
# Runtime rather than build time — no NEXT_PUBLIC_ prefix — so adding a domain
# needs a restart, not a rebuild. Every origin listed must also appear in the
# Supabase redirect allow-list, and hosts are compared including port.
#   APP_URLS=https://app.blkfndr.com,https://staging.blkfndr.com
APP_URLS=

# Optional. Unset renders a project location as a Google Maps link rather than
# an embedded map — a supported mode, not a degraded one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ─── Build time: Supabase ───────────────────────────────────────────────────
# The URL and publishable key are public by design — their safety rests on Row
# Level Security, not on secrecy. Both must also be ARGs in the Dockerfile.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ─── Runtime: secrets ───────────────────────────────────────────────────────
# Server-only. These never reach the browser.

# Bypasses RLS entirely. Used only to read KYC identity columns for admin
# review and to write app_metadata.role. Never prefix this NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=




# Pinata / IPFS uploads — src/app/api/upload-image/route.ts
PINATA_JWT=
PINATA_GATEWAY_URL=
PINATA_GROUP_BLKDFNDR=

# Bearer token for POST /api/indexer — src/app/api/indexer/route.ts
# Required. Without it the endpoint would be publicly callable.
INDEXER_SECRET=

# Genkit — src/ai. The @genkit-ai/googleai plugin reads GEMINI_API_KEY,
# GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY. This file previously named
# GOOGLE_GENERATIVEAI_API_KEY, which matches none of them, so the AI listing
# review did nothing however valid the key was. Optional.
GEMINI_API_KEY=

# ─── Runtime: host port ─────────────────────────────────────────────────────
# Host port the app is published on. The container always listens on 3000.
# Defaults to 8788 when unset; set it if that port is already taken on the
# host, which fails the whole stack at container networking with
#   Bind for 0.0.0.0:8788 failed: port is already allocated
APP_PORT=

# ─── Runtime: indexer scheduling ────────────────────────────────────────────
# Seconds between indexer runs in the docker-compose indexer-cron service.
# The indexer is idempotent, so a short interval only costs RPC calls.
INDEX_INTERVAL_SECONDS=60
